# Base URL of the API (no trailing slash). Vite inlines this at build time,
# so changing it requires restarting `npm start` / rebuilding the image.
VITE_API_URL=http://localhost:8000

# This front-end's own public origin (no trailing slash), used to build
# absolute URLs in SEO tags (canonical, Open Graph, JSON-LD).
VITE_SITE_URL=http://localhost:3000

# OAuth 2.0 Client ID from Google Cloud Console ("Web application" type).
# Public value (not a secret) — must match GOOGLE_CLIENT_ID in woofalk-api/.env.
VITE_GOOGLE_CLIENT_ID=
