# Root-level .env — Compose's own variable substitution file, auto-loaded
# from the directory `docker compose` is run in. Not read by any
# application code directly.
#
#   cp .env.example .env
#
# Only used in production (docker-compose.prod.yml) to give the `db`
# service real MySQL credentials, instead of the public dev defaults in
# docker-compose.yml (gowithdog/gowithdog/root). Must match
# DB_DATABASE/DB_USERNAME/DB_PASSWORD in woofalk-api/.env.production —
# that's what the api service actually connects with.
DB_DATABASE=woofalk
DB_USERNAME=woofalk
DB_PASSWORD=
DB_ROOT_PASSWORD=
