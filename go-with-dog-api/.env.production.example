# Template for go-with-dog-api/.env.production — the file that actually
# lives on the Raspberry Pi (gitignored, never committed). Copy this once
# during server setup, fill in real values, and leave it in place: it is
# read via `env_file:` by docker-compose.prod.yml, independent of the
# api_html volume that gets recreated on every automated deploy.
#
#   cp .env.production.example .env.production
#
# Generate APP_KEY and JWT_SECRET ONCE (see the setup guide) and never
# regenerate them afterwards — rotating either invalidates every existing
# session/JWT for every logged-in user.

APP_KEY=
JWT_SECRET=

# Real production MySQL credentials — do NOT reuse the dev defaults
# (gowithdog/gowithdog/root) from docker-compose.yml for a publicly
# reachable server. Must match whatever the `db` service is configured
# with on the Pi.
DB_DATABASE=gowithdog
DB_USERNAME=gowithdog
DB_PASSWORD=

# CORS_ALLOWED_ORIGINS is NOT read from this file — docker-compose.prod.yml
# sets it directly via `${CORS_ALLOWED_ORIGINS:-https://gowithdog.fr}`,
# which always wins over an env_file value for the same key. To change it,
# export CORS_ALLOWED_ORIGINS before `docker compose up`, or put it in a
# top-level `.env` file at the repo root (Compose's own variable
# substitution file, different from this one).

# Mail — pick whichever transport is actually used in production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@gowithdog.fr"
MAIL_FROM_NAME="GoWithDog"

# Only needed if MAIL_MAILER=mailgun / brevo+api respectively.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
BREVO_KEY=
